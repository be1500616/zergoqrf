# .env.example

# Supabase
# Use the default values from the Supabase local development setup
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres

# You can get the ANON_KEY and SERVICE_ROLE_KEY from the Supabase CLI output when you run `supabase start`
ANON_KEY=your_anon_key
SERVICE_ROLE_KEY=your_service_role_key

# Backend
DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres
REDIS_URL=redis://redis:6379

# Frontend
# The port for the Flutter web development server
FRONTEND_PORT=3000
